# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# --- Database (used by docker compose and by the n8n Postgres credential) ---
POSTGRES_USER=triage
POSTGRES_PASSWORD=change-me
POSTGRES_DB=triage

# --- n8n ---
# Any long random string. n8n uses it to encrypt stored credentials.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string

# --- Webhook protection: callers must send  Authorization: Bearer <this value> ---
WEBHOOK_TOKEN=replace-with-a-long-random-token

# --- Mock CRM (the workflow calls it with a Bearer token) ---
CRM_TOKEN=demo-crm-token

# --- LLM provider (any OpenAI-compatible chat completions endpoint) ---
# Mock (no key needed, for tests):   LLM_BASE_URL=http://mock-llm:4020/v1   LLM_API_KEY=mock   LLM_MODEL=mock-triage-model
# Groq (free tier):                  LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
# Gemini (free tier):                LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   LLM_MODEL=gemini-2.5-flash
# OpenAI:                            LLM_BASE_URL=https://api.openai.com/v1
LLM_BASE_URL=http://mock-llm:4020/v1
LLM_API_KEY=mock
LLM_MODEL=mock-triage-model

# Estimated pricing used only for the cost column in llm_runs (USD per million tokens).
LLM_INPUT_PER_MILLION=0.59
LLM_OUTPUT_PER_MILLION=0.79
